{
  "base_keymap": "VSCode",
  "auto_install_extensions": {
    "fleet-themes": true,
  },
  "theme": "Fleet Dark",
  "icon_theme": "Soft Charmed Icons",
  "ui_font_size": 16.0,
  "agent_ui_font_size": 15,
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Mono",
  "buffer_font_size": 14.0,
  "buffer_line_height": "comfortable",
  "buffer_font_features": {
    "calt": false,
    "liga": false,
    "dlig": false,
  },
  "text_rendering_mode": "platform_default",
  "show_whitespaces": "all",
  "show_wrap_guides": true,
  "current_line_highlight": "all",
  "cursor_blink": true,
  "tab_size": 2,
  "soft_wrap": "none",
  "indent_guides": {
    "coloring": "fixed",
    "background_coloring": "disabled",
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_value_hints": true,
    "show_other_hints": true,
    "show_background": false,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "toggle_on_modifiers_press": null,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "all",
    "show_close_button": "hover",
    "close_position": "left",
  },
  "tab_bar": {
    "show": true,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true,
    "show_pinned_tabs_in_separate_row": false,
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": true,
  },
  "toolbar": {
    "breadcrumbs": true,
    "code_actions": true,
  },
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true,
  },
  "title_bar": {
    "show_project_items": true,
    "show_branch_name": true,
    "show_menus": false,
    "show_user_picture": true,
    "show_sign_in": true,
    "show_onboarding_banner": true,
  },
  "minimap": {
    "show": "never",
  },
  "pane_split_direction_horizontal": "down",
  "pane_split_direction_vertical": "right",
  "bottom_dock_layout": "contained",
  "zoomed_padding": true,
  "restore_on_startup": "last_workspace",
  "autosave": "on_focus_change",
  "use_smartcase_search": true,
  "project_panel": {
    "dock": "left",
    "button": true,
    "hide_root": false,
    "git_status": true,
    "hide_hidden": false,
    "hide_gitignore": false,
    "entry_spacing": "comfortable",
    "indent_size": 12,
    "folder_icons": false,
    "sticky_scroll": true,
    "scrollbar": {
      "show": "auto",
    },
  },
  "outline_panel": {
    "dock": "left",
    "button": true,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
    "status_style": "label_color",
    "sort_by_path": false,
    "collapse_untracked_diff": false,
  },
  "terminal": {
    "dock": "bottom",
    "button": true,
    "default_height": 320,
    "working_directory": "current_project_directory",
    "font_family": "JetBrainsMonoNL Nerd Font",
    "font_size": 13,
    "font_weight": 400,
    "font_features": {
      "calt": false,
      "liga": false,
      "dlig": false,
    },
    "cursor_shape": "bar",
    "blinking": "terminal_controlled",
    "keep_selection_on_copy": false,
    "option_as_meta": false,
    "toolbar": {
      "breadcrumbs": false,
    },
    "scrollbar": {
      "show": "always",
    },
  },
  "debugger": {
    "button": true,
  },
  "search": {
    "button": true,
    "regex": true,
  },
  "diagnostics": {
    "button": true,
  },
  "disable_ai": false,
  // Copilot tab completion only — agent panel, inline assist and toolbar button off
  "edit_predictions": {
    "provider": "copilot",
    "copilot": {
      "enable_next_edit_suggestions": true,
    },
  },
  "agent": {
    "enabled": false,
    "button": false,
    "dock": "right",
    "default_profile": "write",
  },
  "git": {
    "branch_picker": {
      "show_author_name": true,
    },
    "inline_blame": {
      "show_commit_summary": true,
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.ij",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
  ],
}
