[user]
	name = 
	email = 
	signingkey = 

[gpg]
	program = /opt/homebrew/bin/gpg

[init]
	defaultBranch = main

[core]
	editor = code --wait
	pager = delta
	quotepath = false
	fsmonitor = true
	untrackedCache = true

[help]
	autocorrect = prompt

[status]
	short = true
	branch = true

[commit]
	gpgsign = true
	verbose = true

[diff]
	algorithm = histogram
	colorMoved = default
	colorMovedWS = allow-indentation-change
	tool = vscode

[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	dark = true
	syntax-theme = ansi
	minus-style = syntax "#2b1c1a"
	minus-emph-style = syntax "#4d2e29"
	plus-style = syntax "#19251e"
	plus-emph-style = syntax "#2a4133"
	hyperlinks = true
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"

[column]
	ui = auto

[branch]
	sort = -committerdate

[tag]
	gpgsign = true
	sort = version:refname

[pull]
	rebase = true

[rebase]
	autoStash = true
	updateRefs = true
	autoSquash = true

[merge]
	conflictStyle = zdiff3
	tool = vscode

[mergetool]
	keepBackup = false

[mergetool "vscode"]
	cmd = code --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"

[rerere]
	enabled = true
	autoupdate = true

[fetch]
	prune = true
	pruneTags = true
	writeCommitGraph = true

[push]
	autoSetupRemote = true
	followTags = true

[transfer]
	fsckObjects = true

[credential]
	helper =
	helper = osxkeychain
