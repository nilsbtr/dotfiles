# ~/.zshrc.local — machine-specific settings & secrets (sourced last by ~/.zshrc, never committed)
#
# Copy to ~/.zshrc.local and uncomment what you need. Runs after everything else,
# so it can override aliases, env vars and PATH. Note: it runs *after* compinit,
# so fpath additions here won't reach tab completion.

# Secrets / tokens
# export GITHUB_TOKEN=…
# export NPM_TOKEN=…

# Extra PATH entries for this machine only
# path+=(/opt/work/bin)

# Per-machine overrides
# export EDITOR=vim
# alias work='cd ~/Work'
